---
// A crew patch, as agencies sew them for a mission: a stitched border, the name round the rim, a motto under it,
// and a small scene in the middle (a world's limb, an orbit, a few stars) behind the emblem.
import { icons } from '../data/icons';

interface Props { n: number; rim: string; motto: string; icon: keyof typeof icons }
const { n, rim, motto, icon } = Astro.props;
// each patch gets its own sky, always the same one: a tiny seeded generator
let seed = (n + 1) * 2654435761;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const stars = Array.from({ length: 6 }, () => { const a = rnd() * Math.PI * 2, r = 12 + rnd() * 24; return [60 + Math.cos(a) * r, 52 + Math.sin(a) * r * 0.8, 0.6 + rnd() * 0.7]; });
const tilt = -30 + rnd() * 60;
const limb = 44 + rnd() * 32;
---
<svg class="patch" viewBox="0 0 120 120" aria-hidden="true">
  <defs>
    <path id={`pt${n}`} d="M16 60A44 44 0 0 1 104 60" />
    <path id={`pb${n}`} d="M9 60A51 51 0 0 0 111 60" />
    <clipPath id={`pc${n}`}><circle cx="60" cy="60" r="37" /></clipPath>
  </defs>
  <circle class="cloth" cx="60" cy="60" r="58" />
  <circle class="stitch" cx="60" cy="60" r="55.4" />
  <circle class="field" cx="60" cy="60" r="37" />
  <g clip-path={`url(#pc${n})`}>
    <circle class="limb" cx={limb} cy="150" r="66" />
    <ellipse class="orbit" cx="60" cy="58" rx="52" ry="13" transform={`rotate(${tilt.toFixed(1)} 60 58)`} />
    {stars.map(([x, y, r]) => (<circle class="star" cx={x.toFixed(1)} cy={y.toFixed(1)} r={r.toFixed(1)} />))}
  </g>
  <circle class="rule" cx="60" cy="60" r="37" />
  <g class="emblem" transform="translate(60 57) scale(1.75) translate(-12 -12)" set:html={icons[icon]} />
  <text class="rim"><textPath href={`#pt${n}`} startOffset="50%">{rim}</textPath></text>
  <text class="rim motto"><textPath href={`#pb${n}`} startOffset="50%">{motto}</textPath></text>
  <path class="star" d="M9 60l2.2-1.2L12.4 56.6l1.2 2.2 2.2 1.2-2.2 1.2-1.2 2.2-1.2-2.2zM104.2 60l2.2-1.2 1.2-2.2 1.2 2.2 2.2 1.2-2.2 1.2-1.2 2.2-1.2-2.2z" />
</svg>
