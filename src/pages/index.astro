---
import Base from '../layouts/Base.astro';
import Lens from '../components/Lens.svelte';
import Atlas from '../components/Atlas.svelte';
import { site, flightPlan, missions, instruments, alsoAboard, offDuty } from '../data/site';

const featured = missions.filter((m) => m.line);
const others = missions.filter((m) => !m.line);
// Eurobot already flies under Missions; the plan keeps the four latest steps
const plan = flightPlan.filter((s) => s.phase !== 'alumni').slice(0, 4);
---

<Base
  title="Jérémy · Data science and robotics"
  description="Personal site of Jérémy (Swaiku): Master's student in Data Science at HES-SO in Lausanne, working on MLOps, UAV navigation and self-hosted infrastructure."
>
  <main id="top" class="sheet">
    <section class="tile t-id" aria-labelledby="who">
      <a class="k hi status" href="#uplink"><span class="dot" aria-hidden="true"></span>{site.status}</a>
      <div>
        <h1 id="who">{site.handle}</h1>
        <p class="role">{site.role}</p>
        <p class="sub">Master's student in Data Science · HES-SO Lausanne</p>
      </div>
      <p class="lead">Machine learning, autonomous robots, and the infrastructure that keeps them flying.</p>
    </section>

    <section id="missions" class="tile t-missions" aria-labelledby="missions-h">
      <span class="k no" aria-hidden="true">01</span>
      <h2 id="missions-h" class="k hi">Missions</h2>
      <ol class="missions">
        {featured.map((m) => (
          <li>
            <span class="k">{m.year}</span>
            <b>{m.href ? <a href={m.href} rel="noopener">{m.name.replace(/^Bachelor thesis: /, '')} ↗</a> : m.name.replace(/^Bachelor thesis: /, '')}</b>
            <p>{m.line}</p>
          </li>
        ))}
      </ol>
      <p class="also">
        <span class="k">Also</span>
        {others.map((m, i) => (<>{i > 0 && ', '}{m.href ? <a href={m.href} rel="noopener">{m.name} ↗</a> : m.name}</>))}
      </p>
    </section>

    <div class="lens" data-lens>
      <Lens client:only="svelte" base={site.base.split(',')[0]} coords={site.coords} tz={site.timezone} />
    </div>

    <section class="tile t-log" aria-labelledby="log-h">
      <h2 id="log-h" class="k">Flight log</h2>
      <p>First entry in preparation: how the planet on this page is generated.</p>
    </section>

    <section id="payload" class="tile t-payload" aria-labelledby="payload-h">
      <span class="k no" aria-hidden="true">02</span>
      <h2 id="payload-h" class="k hi">Payload <span class="k">· flown on</span></h2>
      <dl class="instruments">
        {instruments.map((i) => (<><dt>{i.tools}</dt><dd class="k">{i.flew}</dd></>))}
      </dl>
      <p class="also"><span class="k">Also aboard</span> {alsoAboard.join(', ')}</p>
    </section>

    <section class="tile t-plan" aria-labelledby="plan-h">
      <span class="k no" aria-hidden="true">03</span>
      <h2 id="plan-h" class="k hi">Flight plan</h2>
      <ol class="plan">
        {plan.map((s) => (
          <li class:list={{ now: s.phase === 'now' }}><span class="pin" aria-hidden="true"></span><span>{s.title}</span><span class="k">{s.phase}</span></li>
        ))}
      </ol>
    </section>

    <section id="off-duty" class="tile t-leave" aria-labelledby="leave-h">
      <h2 id="leave-h" class="k hi">Shore leave</h2>
      <p>{offDuty.map((o) => o.k).join(' · ')}</p>
    </section>

    <section id="uplink" class="tile t-uplink" aria-labelledby="uplink-h">
      <h2 id="uplink-h" class="call">Open a channel</h2>
      <p class="k">
        {site.linkedin && <a href={site.linkedin} rel="noopener">LinkedIn ↗</a>}
        <a href={site.github} rel="noopener">GitHub ↗</a>
      </p>
    </section>
  </main>

  <Atlas client:only="svelte" />

  <script>
    // the scene poses the world from `data-stage`: aim it at the middle of the lens, sized to its height.
    // The pose is in page coordinates (as if unscrolled): the scene adds the scroll itself
    const lens = document.querySelector<HTMLElement>('[data-lens]')!;
    const aim = () => {
      const r = lens.getBoundingClientRect();
      const x = ((r.left + r.width / 2) / innerWidth - 0.5) * 2;
      const y = -((r.top + scrollY + r.height / 2) / innerHeight - 0.5) * 2;
      const s = (0.46 * Math.min(r.width, r.height)) / (0.5 * Math.min(innerWidth, innerHeight));
      lens.dataset.stage = [x, y, s].map((v) => v.toFixed(3)).join(',');
      // the same aim for the CSS stand-in shown when there is no GPU
      const d = 0.92 * Math.min(r.width, r.height);
      const root = document.documentElement.style;
      root.setProperty('--lens-l', `${r.left + r.width / 2 - d / 2}px`);
      root.setProperty('--lens-t', `${r.top + r.height / 2 - d / 2}px`);
      root.setProperty('--lens-d', `${d}px`);
      root.setProperty('--lens-r', 'auto');
    };
    aim();
    addEventListener('resize', aim);
    // the CSS stand-in sits in the fixed layer too: move it with the lens
    addEventListener('scroll', aim, { passive: true });
  </script>
</Base>
