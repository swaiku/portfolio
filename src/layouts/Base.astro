---
import '../styles/global.css';
import Planet from '../components/Planet.svelte';
import display from '@fontsource/unbounded/files/unbounded-latin-700-normal.woff2?url';
import body from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060818" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jérémy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A glowing black hole with its accretion disk, rendered by the site's procedural planet" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={display} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={body} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.dataset.js = '';
    </script>
  </head>
  <body>
    <Planet client:only="svelte" />
    <slot />
    <script>
      import { faviconFor } from '../lib/favicon';
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      els.forEach((el) => io.observe(el));
      const showInfo = (d: { name: string; kind: string; family?: string; accent?: string; ring?: boolean }) => {
        if (d.accent) document.querySelector<HTMLLinkElement>('link[rel="icon"]')!.href = faviconFor(d.family ?? 'planet', d.accent, d.ring);
        document.querySelectorAll('[data-planet-name]').forEach((el) => (el.textContent = `${d.name} · ${d.kind}`));
      };
      addEventListener('planet:info', (e) => showInfo((e as CustomEvent).detail));
      const early = (window as unknown as { __planet?: Parameters<typeof showInfo>[0] }).__planet;
      if (early) showInfo(early);
      document.querySelector('[data-reseed]')?.addEventListener('click', () => dispatchEvent(new Event('planet:reseed')));
    </script>
  </body>
</html>
